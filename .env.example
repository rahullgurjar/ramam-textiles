# ==============================================================================
# RAMAM TEXTILES — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# ⚠️ SECURITY NOTICE:
# In Vite applications, variables prefixed with "VITE_" are compiled directly
# into the public client JavaScript bundle. Anyone inspecting page sources or
# network traffic can see them.
# 
# NEVER place private secrets (e.g. database credentials, payment private keys,
# master admin tokens) into VITE_* variables.
# ==============================================================================

# Google Apps Script Web App Webhook URL (Handles incoming customer inquiries)
# Generated after deploying google-apps-script/Code.gs as Web App (Execute as: Me, Access: Anyone)
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYED_WEBAPP_ID_HERE/exec

# Optional Admin Portal Passphrase Salt (for client-side staff gate)
VITE_ADMIN_PORTAL_SALT=ramam_textiles_jaipur_secure_salt_2026
